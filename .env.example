# ==========================================
# FMTTEMA - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ==========================================

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/fmttema_db
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_postgresql_aqui

# Segredo JWT (Chave criptográfica para geração de tokens)
# Em produção, utilize uma chave aleatória e segura de 256 bits ou mais
JWT_SECRET=fmttema-secret-token-key-desenvolvimento-undb-2026

# Credenciais do Administrador Inicial (criado no primeiro boot)
ADMIN_EMAIL=admin@fmttema.com
ADMIN_PASSWORD=sua_senha_admin_aqui

# Frontend - Endereço da API Backend
VITE_API_URL=http://localhost:8080
